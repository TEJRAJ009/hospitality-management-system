<?xml version="1.0" encoding="UTF-8"?>
<!--
  OWASP Dependency-Check Suppression File — HotelHub
  Ref: https://jeremylong.github.io/DependencyCheck/general/suppression.html

  Instructions:
    1. Run the scan once to discover findings.
    2. For each false positive, copy its <suppress> block here.
    3. Add a <notes> tag explaining WHY it is suppressed.
    4. Review this file quarterly to remove expired suppressions.
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

  <!--
    TEMPLATE — Copy and fill in for each suppression you need.
    Remove the comment tags and fill in the values.

  <suppress until="2025-06-30Z">
    <notes>
      CVE-XXXX-XXXXX — False positive. This dependency is not used in the
      vulnerable code path. Mitigated by [reason]. Review by [date].
    </notes>
    <packageUrl regex="true">^pkg:pypi/package-name@.*$</packageUrl>
    <cve>CVE-XXXX-XXXXX</cve>
  </suppress>
  -->

  <!--
    Example: Suppress a specific CVE for a specific package version.
    Uncomment and edit when needed.

  <suppress until="2025-12-31Z">
    <notes>
      CVE-2023-30861 — Flask session cookie issue. HotelHub uses FastAPI, not Flask.
      This is a false positive from transitive dependency detection.
    </notes>
    <packageUrl regex="true">^pkg:pypi/flask@.*$</packageUrl>
    <cve>CVE-2023-30861</cve>
  </suppress>
  -->

</suppressions>
